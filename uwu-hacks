# ============================================================================
# SUBCOMMAND: navi (Launch navi with credentials)
# ============================================================================
def cmd_navi(args):
    """Launch navi with loaded credentials"""
    db = CTFCredsDB()
    pwned = db.get_pwned()
    target = db.get_target()

    # Set environment variables
    env = os.environ.copy()
    if pwned:
        cred_id, machine, username, domain, password, hash_val, hash_type, notes, status, created_at, updated_at = pwned
        env['PWNED_USER'] = username
        env['PWNED_MACHINE'] = machine
        if domain:
            env['PWNED_DOMAIN'] = domain
        if password:
            env['PWNED_PASS'] = password
        if hash_val:
            env['PWNED_HASH'] = hash_val

    if target:
        cred_id, machine, username, domain, password, hash_val, hash_type, notes, status, created_at, updated_at = target
        env['TARGET_USER'] = username
        env['TARGET_MACHINE'] = machine
        if domain:
            env['TARGET_DOMAIN'] = domain
        if password:
            env['TARGET_PASS'] = password
        if hash_val:
            env['TARGET_HASH'] = hash_val

    # Launch navi
    try:
        result = subprocess.run(['navi', '--print'], env=env, capture_output=True, text=True)
        if result.returncode == 0 and result.stdout.strip():
            cmd = result.stdout.strip()
            print(f"{Colors.CYAN}Executing:{Colors.RESET} {Colors.YELLOW}{cmd}{Colors.RESET}")
            # Execute the command
            os.system(cmd)
    except FileNotFoundError:
        print(f"{Colors.RED}Error: navi is not installed{Colors.RESET}")
        print(f"{Colors.YELLOW}Install with: cargo install navi{Colors.RESET}")

# ============================================================================
# SUBCOMMAND: delete (Delete credential)
# ============================================================================
def cmd_delete(args):
    """Delete a credential from the database"""
    db = CTFCredsDB()
    if db.delete_credential(args.id):
        print(f"{Colors.GREEN}✓ Credential {args.id} deleted{Colors.RESET}")
    else:
        print(f"{Colors.RED}Error: Credential ID {args.id} not found{Colors.RESET}")

# ============================================================================
# MAIN ENTRY POINT
# ============================================================================
def main():
    """Main entry point with argument parsing"""
    parser = argparse.ArgumentParser(
        description='uwu-hacks - Modular CTF credential management toolkit',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""
{Colors.GREEN}Examples:{Colors.RESET}
  {Colors.CYAN}uwu-hacks loot{Colors.RESET} 10.10.11.123 admin -p Password123
  {Colors.CYAN}uwu-hacks list{Colors.RESET}
  {Colors.CYAN}uwu-hacks pwned{Colors.RESET} 1
  {Colors.CYAN}uwu-hacks target{Colors.RESET} 2
  {Colors.CYAN}uwu-hacks export{Colors.RESET} --show
  {Colors.CYAN}eval $(uwu-hacks export){Colors.RESET}
  {Colors.CYAN}uwu-hacks navi{Colors.RESET}

{Colors.GREEN}Subcommands:{Colors.RESET}
  loot      Add credentials to database
  list      List credentials
  pwned     Mark credential as pwned
  target    Mark credential as target
  export    Export credentials to environment
  navi      Launch navi with credentials
  delete    Delete a credential
        """
    )

    subparsers = parser.add_subparsers(dest='command', help='Available commands')

    # Subcommand: loot
    parser_loot = subparsers.add_parser('loot', help='Add credentials to database')
    parser_loot.add_argument('machine', help='Machine/host')
    parser_loot.add_argument('username', help='Username')
    parser_loot.add_argument('-d', '--domain', help='Domain name')
    parser_loot.add_argument('-p', '--password', help='Password')
    parser_loot.add_argument('-H', '--hash', help='Hash value')
    parser_loot.add_argument('-t', '--hash-type', help='Hash type (NTLM, MD5, etc.)')
    parser_loot.add_argument('-n', '--notes', help='Additional notes')
    parser_loot.set_defaults(func=cmd_loot)

    # Subcommand: list
    parser_list = subparsers.add_parser('list', help='List credentials')
    parser_list.add_argument('machine', nargs='?', help='Filter by machine')
    parser_list.add_argument('-s', '--selected', action='store_true', help='Show only pwned/target')
    parser_list.set_defaults(func=cmd_list)

    # Subcommand: pwned
    parser_pwned = subparsers.add_parser('pwned', help='Mark credential as pwned')
    parser_pwned.add_argument('id', type=int, nargs='?', help='Credential ID')
    parser_pwned.add_argument('-c', '--clear', action='store_true', help='Clear pwned status')
    parser_pwned.set_defaults(func=cmd_pwned)

    # Subcommand: target
    parser_target = subparsers.add_parser('target', help='Mark credential as target')
    parser_target.add_argument('id', type=int, nargs='?', help='Credential ID')
    parser_target.add_argument('-c', '--clear', action='store_true', help='Clear target status')
    parser_target.set_defaults(func=cmd_target)

    # Subcommand: export
    parser_export = subparsers.add_parser('export', help='Export credentials to environment')
    parser_export.add_argument('--show', action='store_true', help='Display instead of outputting export commands')
    parser_export.set_defaults(func=cmd_export)

    # Subcommand: navi
    parser_navi = subparsers.add_parser('navi', help='Launch navi with credentials')
    parser_navi.set_defaults(func=cmd_navi)

    # Subcommand: delete
    parser_delete = subparsers.add_parser('delete', help='Delete a credential')
    parser_delete.add_argument('id', type=int, help='Credential ID to delete')
    parser_delete.set_defaults(func=cmd_delete)

    # Parse arguments
    args = parser.parse_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    # Execute subcommand
    args.func(args)

if __name__ == '__main__':
    main()
