# SUBCOMMAND: pwned (Mark as pwned)
# ============================================================================
def cmd_pwned(args):
    """Mark a credential as pwned"""
    db = CTFCredsDB()
    if args.clear:
        # Clear pwned status
        creds = db.get_all_credentials()
        for cred in creds:
            if cred[8] == 'pwned':  # status field
                db.clear_status(cred[0])
        print(f"{Colors.GREEN}✓ Pwned status cleared{Colors.RESET}")
    else:
        if db.mark_pwned(args.id):
            print(f"{Colors.GREEN}✓ Credential {args.id} marked as PWNED!{Colors.RESET}")
        else:
            print(f"{Colors.RED}Error: Credential ID {args.id} not found{Colors.RESET}")

# ============================================================================
# SUBCOMMAND: target (Mark as target)
# ============================================================================
def cmd_target(args):
    """Mark a credential as target"""
    db = CTFCredsDB()
    if args.clear:
        # Clear target status
        creds = db.get_all_credentials()
        for cred in creds:
            if cred[8] == 'target':  # status field
                db.clear_status(cred[0])
        print(f"{Colors.RED}✓ Target status cleared{Colors.RESET}")
    else:
        if db.mark_target(args.id):
            print(f"{Colors.RED}✓ Credential {args.id} marked as TARGET!{Colors.RESET}")
        else:
            print(f"{Colors.RED}Error: Credential ID {args.id} not found{Colors.RESET}")

