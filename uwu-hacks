#!/usr/bin/env python3
"""
uwu-hacks - Modular CTF credential management toolkit
Combines all uwu-* tools into a single unified interface
"""

import sqlite3
import sys
import argparse
import subprocess
import os
from pathlib import Path
from datetime import datetime

# Dracula Theme Colors
class Colors:
    RESET = '\033[0m'
    BOLD = '\033[1m'
    CYAN = '\033[38;2;139;233;253m'
    GREEN = '\033[38;2;80;250;123m'
    ORANGE = '\033[38;2;255;184;108m'
    PINK = '\033[38;2;255;121;198m'
    PURPLE = '\033[38;2;189;147;249m'
    RED = '\033[38;2;255;85;85m'
    YELLOW = '\033[38;2;241;250;140m'
    COMMENT = '\033[38;2;98;114;164m'

class CTFCredsDB:
    """Shared database management class"""
    def __init__(self):
        self.db_dir = Path(os.getcwd()) / '.ctf'
        self.db_path = self.db_dir / 'credentials.db'
        self.init_db()

    def init_db(self):
        """Initialize the database and create table if it doesn't exist"""
        self.db_dir.mkdir(exist_ok=True)
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        cursor.execute('''
            CREATE TABLE IF NOT EXISTS credentials (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                machine TEXT NOT NULL,
                username TEXT NOT NULL,
                domain TEXT,
                password TEXT,
                hash TEXT,
                hash_type TEXT,
                notes TEXT,
                status TEXT DEFAULT 'none',
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                UNIQUE(machine, username, domain)
            )
        ''')
        conn.commit()
        conn.close()

    def add_credential(self, machine, username, password=None, hash_val=None, hash_type=None, domain=None, notes=None):
        """Add or update a credential entry"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        try:
            cursor.execute('''
                INSERT INTO credentials (machine, username, domain, password, hash, hash_type, notes)
                VALUES (?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(machine, username, domain) DO UPDATE SET
                    password = COALESCE(excluded.password, password),
                    hash = COALESCE(excluded.hash, hash),
                    hash_type = COALESCE(excluded.hash_type, hash_type),
                    notes = COALESCE(excluded.notes, notes),
                    updated_at = CURRENT_TIMESTAMP
            ''', (machine, username, domain, password, hash_val, hash_type, notes))
            conn.commit()
            return True
        except sqlite3.Error as e:
            print(f"{Colors.RED}Database error: {e}{Colors.RESET}")
            return False
        finally:
            conn.close()

    def get_all_credentials(self):
        """Retrieve all credentials"""
        if not self.db_path.exists():
            return []
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        cursor.execute('''
            SELECT id, machine, username, domain, password, hash, hash_type, notes, status, created_at, updated_at
            FROM credentials
            ORDER BY machine, username
        ''')
        results = cursor.fetchall()
        conn.close()
        return results

    def get_by_machine(self, machine):
        """Get credentials for a specific machine"""
        if not self.db_path.exists():
            return []
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        cursor.execute('''
            SELECT id, machine, username, domain, password, hash, hash_type, notes, status, created_at, updated_at
            FROM credentials
            WHERE machine LIKE ?
            ORDER BY username
        ''', (f'%{machine}%',))
        results = cursor.fetchall()
        conn.close()
        return results

    def get_pwned(self):
        """Get the credential marked as pwned"""
        if not self.db_path.exists():
            return None
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        cursor.execute('''
            SELECT id, machine, username, domain, password, hash, hash_type, notes, status, created_at, updated_at
            FROM credentials
            WHERE status = 'pwned'
            LIMIT 1
        ''')
        result = cursor.fetchone()
        conn.close()
        return result

    def get_target(self):
        """Get the credential marked as target"""
        if not self.db_path.exists():
            return None
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        cursor.execute('''
            SELECT id, machine, username, domain, password, hash, hash_type, notes, status, created_at, updated_at
            FROM credentials
            WHERE status = 'target'
            LIMIT 1
        ''')
        result = cursor.fetchone()
        conn.close()
        return result

    def mark_pwned(self, cred_id):
        """Mark a credential as pwned"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        try:
            # Clear any existing pwned status
            cursor.execute("UPDATE credentials SET status = 'none' WHERE status = 'pwned'")
            # Set new pwned status
            cursor.execute("UPDATE credentials SET status = 'pwned' WHERE id = ?", (cred_id,))
            conn.commit()
            return cursor.rowcount > 0
        finally:
            conn.close()

    def mark_target(self, cred_id):
        """Mark a credential as target"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        try:
            # Clear any existing target status
            cursor.execute("UPDATE credentials SET status = 'none' WHERE status = 'target'")
            # Set new target status
            cursor.execute("UPDATE credentials SET status = 'target' WHERE id = ?", (cred_id,))
            conn.commit()
            return cursor.rowcount > 0
        finally:
            conn.close()

    def clear_status(self, cred_id):
        """Clear the status of a credential"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        try:
            cursor.execute("UPDATE credentials SET status = 'none' WHERE id = ?", (cred_id,))
            conn.commit()
            return cursor.rowcount > 0
        finally:
            conn.close()

    def delete_credential(self, cred_id):
        """Delete a credential"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()
        try:
            cursor.execute("DELETE FROM credentials WHERE id = ?", (cred_id,))
            conn.commit()
            return cursor.rowcount > 0
        finally:
            conn.close()

# ============================================================================
# SUBCOMMAND: loot (Add credentials)
# ============================================================================
def cmd_loot(args):
    """Add credentials to the database"""
    db = CTFCredsDB()
    if db.add_credential(
        args.machine,
        args.username,
        args.password,
        args.hash,
        args.hash_type,
        args.domain,
        args.notes
    ):
        print(f"\n{Colors.GREEN}✓ Credential added/updated successfully!{Colors.RESET}")
        print(f"{Colors.CYAN}Machine:{Colors.RESET} {args.machine}")
        if args.domain:
            print(f"{Colors.CYAN}Domain:{Colors.RESET} {args.domain}")
        print(f"{Colors.CYAN}Username:{Colors.RESET} {args.username}")
        if args.password:
            print(f"{Colors.CYAN}Password:{Colors.RESET} {args.password}")
        if args.hash:
            print(f"{Colors.CYAN}Hash:{Colors.RESET} {args.hash[:30]}...")
        print()

# ============================================================================
# SUBCOMMAND: list (List credentials)
# ============================================================================
def cmd_list(args):
    """List credentials from the database"""
    db = CTFCredsDB()

    # Print banner
    print(f"""
{Colors.PURPLE}╔═══════════════════════════════════════════════════════════╗
║                                                           ║
║          {Colors.PINK}📋 uwu-hacks list - View Credentials 📋{Colors.PURPLE}          ║
║                                                           ║
╚═══════════════════════════════════════════════════════════╝{Colors.RESET}
""")

    if args.selected:
        # Show only pwned and target
        pwned = db.get_pwned()
        target = db.get_target()

        if pwned:
            print(f"\n{Colors.GREEN}PWNED:{Colors.RESET}")
            print_credential_row(pwned)

        if target:
            print(f"\n{Colors.RED}TARGET:{Colors.RESET}")
            print_credential_row(target)

        if not pwned and not target:
            print(f"{Colors.YELLOW}No credentials marked as pwned or target{Colors.RESET}")
    else:
        # Get credentials
        if args.machine:
            creds = db.get_by_machine(args.machine)
            title = f"Credentials for: {args.machine}"
        else:
            creds = db.get_all_credentials()
            title = "All Credentials"

        if not creds:
            print(f"{Colors.YELLOW}No credentials found{Colors.RESET}\n")
            return

        # Print header
        print(f"\n{Colors.PINK}{title}{Colors.RESET}")
        print(f"{Colors.PURPLE}{'═' * 180}{Colors.RESET}")
        print(f"{Colors.PINK}{Colors.BOLD}{'ID':<6}{'Machine':<26}{'Domain':<16}{'Username':<21}{'Password':<21}{'Hash':<31}{'Type':<11}{'Status':<10}{Colors.RESET}")
        print(f"{Colors.PURPLE}{'═' * 180}{Colors.RESET}")

        # Print credentials
        for cred in creds:
            print_credential_row(cred)

        print(f"{Colors.PURPLE}{'═' * 180}{Colors.RESET}")
        print(f"\n{Colors.GREEN}Total: {len(creds)} credential(s){Colors.RESET}\n")

def print_credential_row(cred):
    """Helper to print a single credential row"""
    cred_id, machine, username, domain, password, hash_val, hash_type, notes, status, created_at, updated_at = cred

    # Truncate long values
    display_hash = (hash_val[:28] + '...') if hash_val and len(hash_val) > 28 else (hash_val or '-')
    display_password = (password[:18] + '...') if password and len(password) > 18 else (password or '-')

    # Color status
    if status == 'pwned':
        status_colored = f"{Colors.GREEN}{status:<10}{Colors.RESET}"
    elif status == 'target':
        status_colored = f"{Colors.RED}{status:<10}{Colors.RESET}"
    else:
        status_colored = f"{Colors.COMMENT}{'-':<10}{Colors.RESET}"

    print(f"{Colors.CYAN}{cred_id:<5}{Colors.RESET} "
          f"{Colors.GREEN}{machine:<25}{Colors.RESET} "
          f"{Colors.PURPLE}{(domain or '-'):<15}{Colors.RESET} "
          f"{Colors.ORANGE}{username:<20}{Colors.RESET} "
          f"{Colors.YELLOW}{display_password:<20}{Colors.RESET} "
          f"{Colors.PURPLE}{display_hash:<30}{Colors.RESET} "
          f"{Colors.COMMENT}{(hash_type or '-'):<10}{Colors.RESET} "
          f"{status_colored} ")

