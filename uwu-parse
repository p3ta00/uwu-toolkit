def main():
    # Check for help flag
    if len(sys.argv) > 1 and sys.argv[1] in ['-h', '--help', 'help']:
        print_help()
        sys.exit(0)

    # Parse arguments
    machine = None
    domain = None
    parser_type = 'auto'
    input_text = None
    input_file = None

    i = 1
    while i < len(sys.argv):
        if sys.argv[i] in ['-m', '--machine'] and i + 1 < len(sys.argv):
            machine = sys.argv[i + 1]
            i += 2
        elif sys.argv[i] in ['-d', '--domain'] and i + 1 < len(sys.argv):
            domain = sys.argv[i + 1]
            i += 2
        elif sys.argv[i] in ['-t', '--type'] and i + 1 < len(sys.argv):
            parser_type = sys.argv[i + 1]
            i += 2
        else:
            input_file = sys.argv[i]
            i += 1

    # Get input from stdin or file
    if input_file:
        try:
            with open(input_file, 'r') as f:
                input_text = f.read()
        except Exception as e:
            print(f"{Colors.RED}Error reading file: {e}{Colors.RESET}")
            sys.exit(1)
    elif not sys.stdin.isatty():
        input_text = sys.stdin.read()
    else:
        print(f"{Colors.RED}Error: No input provided{Colors.RESET}")
        print(f"Use: {Colors.CYAN}command | uwu-parse{Colors.RESET} or {Colors.CYAN}uwu-parse <file>{Colors.RESET}")
        print(f"Run {Colors.CYAN}uwu-parse -h{Colors.RESET} for help\n")
        sys.exit(1)

    # Parse the input
    parser = CredentialParser(machine=machine, domain=domain)

    print(f"\n{Colors.PURPLE}Parsing tool output...{Colors.RESET}\n")

    if parser_type == 'auto':
        found = parser.parse_auto(input_text)
    else:
        parser_map = {
            'secretsdump': parser.parse_secretsdump,
            'nxc': parser.parse_nxc,
            'cme': parser.parse_nxc,
            'responder': parser.parse_responder,
            'hashcat': parser.parse_hashcat_potfile,
            'john': parser.parse_john,
            'kerbrute': parser.parse_kerbrute,
        }

        parser_func = parser_map.get(parser_type.lower())
        if not parser_func:
            print(f"{Colors.RED}Unknown parser type: {parser_type}{Colors.RESET}")
            sys.exit(1)

        found = parser_func(input_text)

    if not parser.credentials:
        print(f"{Colors.YELLOW}No credentials found in input{Colors.RESET}\n")
        sys.exit(0)

    # Add to database
    db = CTFCredsDB()
    added = 0

    for cred in parser.credentials:
        # Rename 'hash' key to 'hash_val' for function compatibility
        if 'hash' in cred:
            cred['hash_val'] = cred.pop('hash')

        if db.add_credential(**cred):
            added += 1

    print(f"\n{Colors.GREEN}✓ Added {added} credential(s) to database{Colors.RESET}")
    print(f"Run {Colors.CYAN}uwu-list{Colors.RESET} to view them\n")

if __name__ == '__main__':
    main()
