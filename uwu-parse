class CTFCredsDB:
    def __init__(self):
        self.db_dir = Path(os.getcwd()) / '.ctf'
        self.db_path = self.db_dir / 'credentials.db'
        self.init_db()

    def init_db(self):
        """Initialize the database and create table if it doesn't exist"""
        self.db_dir.mkdir(exist_ok=True)

        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
            CREATE TABLE IF NOT EXISTS credentials (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                machine TEXT NOT NULL,
                username TEXT NOT NULL,
                domain TEXT,
                password TEXT,
                hash TEXT,
                hash_type TEXT,
                notes TEXT,
                status TEXT DEFAULT 'none',
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                UNIQUE(machine, username, domain)
            )
        ''')

        conn.commit()
        conn.close()

    def add_credential(self, machine, username, password=None, hash_val=None, hash_type=None, domain=None, notes=None):
        """Add or update a credential entry"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        try:
            cursor.execute('''
                INSERT INTO credentials (machine, username, domain, password, hash, hash_type, notes)
                VALUES (?, ?, ?, ?, ?, ?, ?)
                ON CONFLICT(machine, username, domain) DO UPDATE SET
                    password = COALESCE(excluded.password, password),
                    hash = COALESCE(excluded.hash, hash),
                    hash_type = COALESCE(excluded.hash_type, hash_type),
                    notes = COALESCE(excluded.notes, notes),
                    updated_at = CURRENT_TIMESTAMP
            ''', (machine, username, domain, password, hash_val, hash_type, notes))

            conn.commit()
            return True
        except sqlite3.Error as e:
            print(f"{Colors.RED}Database error: {e}{Colors.RESET}")
            return False
        finally:
            conn.close()

class CredentialParser:
    """Parse output from various pentesting tools"""

    def __init__(self, machine=None, domain=None):
        self.machine = machine or "unknown"
        self.domain = domain
        self.credentials = []

    def parse_secretsdump(self, text):
        """Parse impacket-secretsdump output"""
        found = 0

        # Pattern: DOMAIN\username:RID:LMhash:NThash:::
        pattern = r'([^:\n]+)\\([^:]+):(\d+):([a-fA-F0-9]{32}):([a-fA-F0-9]{32}):::'

        for match in re.finditer(pattern, text):
            domain = match.group(1)
            username = match.group(2)
            lm_hash = match.group(4)
            nt_hash = match.group(5)

            # Combine LM:NT format
            hash_val = f"{lm_hash}:{nt_hash}"

            self.credentials.append({
                'machine': self.machine,
                'username': username,
                'domain': domain if domain != 'LOCAL' else None,
                'hash': hash_val,
                'hash_type': 'NTLM',
                'notes': 'From secretsdump'
            })
            found += 1

        return found

    def parse_nxc(self, text):
        """Parse NetExec/CrackMapExec output"""
        found = 0

        # Pattern: SMB         10.10.11.123    445    DC01    [+] DOMAIN\user:password
        pattern = r'\[[\+\*]\]\s+(?:([A-Z0-9_-]+)[\\\/])?([^\s:]+)(?::([^\s]+))?\s*(?:\(([^)]+)\))?'

        for line in text.split('\n'):
            if '[+]' in line or '[*]' in line:
                # Try to extract target IP/hostname from line
                target_match = re.search(r'(\d+\.\d+\.\d+\.\d+)\s+\d+\s+([A-Z0-9_-]+)', line)
                machine = self.machine
                if target_match:
                    machine = target_match.group(1)

                match = re.search(pattern, line)
                if match:
                    domain = match.group(1)
                    username = match.group(2)
                    password = match.group(3)

                    if username and password:
                        self.credentials.append({
                            'machine': machine,
                            'username': username,
                            'domain': domain,
                            'password': password,
                            'notes': 'From NetExec/CME'
                        })
                        found += 1

        return found

    def parse_hashcat_potfile(self, text):
        """Parse hashcat potfile or --show output"""
        found = 0

        # Pattern: hash:cracked_password
        for line in text.split('\n'):
            if ':' in line:
                parts = line.strip().split(':')
                if len(parts) >= 2:
                    hash_val = parts[0]
                    password = ':'.join(parts[1:])  # In case password contains :

                    # Determine hash type by length
                    hash_type = 'Unknown'
                    if len(hash_val) == 32:
                        hash_type = 'NTLM or MD5'
                    elif len(hash_val) == 64:
                        hash_type = 'SHA256'
                    elif len(hash_val) == 40:
                        hash_type = 'SHA1'

                    self.credentials.append({
                        'machine': self.machine,
                        'username': 'cracked',
                        'hash': hash_val,
                        'password': password,
                        'hash_type': hash_type,
                        'notes': 'Cracked from hashcat'
                    })
                    found += 1

        return found

    def parse_responder(self, text):
        """Parse Responder logs"""
        found = 0

        # Pattern: [+] Listening for events...
        # [SMB] NTLMv2-SSP Client   : 10.10.11.123
        # [SMB] NTLMv2-SSP Username : DOMAIN\user
        # [SMB] NTLMv2-SSP Hash     : user::DOMAIN:...

        current_client = None
        current_username = None

        for line in text.split('\n'):
            client_match = re.search(r'Client\s*:\s*(\S+)', line)
            if client_match:
                current_client = client_match.group(1)

            username_match = re.search(r'Username\s*:\s*(?:([^\\]+)\\)?(\S+)', line)
            if username_match:
                domain = username_match.group(1)
                current_username = username_match.group(2)

            hash_match = re.search(r'Hash\s*:\s*([^:]+)::([^:]*):([^:]+):([^:]+):(\S+)', line)
            if hash_match and current_username:
                username = hash_match.group(1)
                domain = hash_match.group(2) or None
                hash_val = line.split('Hash')[1].strip().lstrip(':').strip()

                self.credentials.append({
                    'machine': current_client or self.machine,
                    'username': username,
                    'domain': domain,
                    'hash': hash_val,
                    'hash_type': 'NTLMv2',
                    'notes': 'From Responder'
                })
                found += 1

        return found

    def parse_kerbrute(self, text):
        """Parse kerbrute output"""
        found = 0

        # Pattern: [+] VALID USERNAME:	 user@domain.local
        pattern = r'\[\+\]\s+VALID USERNAME:\s+([^@\s]+)(?:@(\S+))?'

        for match in re.finditer(pattern, text):
            username = match.group(1)
            domain = match.group(2) or self.domain

            self.credentials.append({
                'machine': self.machine,
                'username': username,
                'domain': domain,
                'notes': 'Valid user from kerbrute'
            })
            found += 1

        return found

    def parse_john(self, text):
        """Parse John the Ripper output"""
        found = 0

        # Pattern: password         (user)
        pattern = r'^(\S+)\s+\(([^)]+)\)'

        for line in text.split('\n'):
            match = re.match(pattern, line.strip())
            if match:
                password = match.group(1)
                username = match.group(2)

                self.credentials.append({
                    'machine': self.machine,
                    'username': username,
                    'password': password,
                    'notes': 'Cracked from John'
                })
                found += 1

        return found

    def parse_auto(self, text):
        """Automatically detect format and parse"""
        total = 0

        # Try each parser
        parsers = [
            ('secretsdump', self.parse_secretsdump),
            ('NetExec/CME', self.parse_nxc),
            ('Responder', self.parse_responder),
            ('Kerbrute', self.parse_kerbrute),
            ('Hashcat', self.parse_hashcat_potfile),
            ('John', self.parse_john),
        ]

        for name, parser in parsers:
            found = parser(text)
            if found > 0:
                print(f"{Colors.GREEN}✓ Detected {name} output: {found} credential(s){Colors.RESET}")
                total += found

        return total

