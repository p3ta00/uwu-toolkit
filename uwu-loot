class CTFCredsDB:
    def __init__(self):
        self.db_dir = Path(os.getcwd()) / '.ctf'
        self.db_path = self.db_dir / 'credentials.db'
        self.init_db()

    def init_db(self):
        """Initialize the database and create table if it doesn't exist"""
        self.db_dir.mkdir(exist_ok=True)

        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        # Check if table exists and needs migration
        cursor.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='credentials'")
        table_exists = cursor.fetchone()

        if table_exists:
            # Check if machine column is NOT NULL (old schema)
            cursor.execute("PRAGMA table_info(credentials)")
            columns = cursor.fetchall()
            machine_col = [col for col in columns if col[1] == 'machine']

            if machine_col and machine_col[0][3] == 1:  # NOT NULL constraint exists
                # Migrate to new schema
                cursor.execute('''
                    CREATE TABLE credentials_new (
                        id INTEGER PRIMARY KEY AUTOINCREMENT,
                        machine TEXT,
                        username TEXT,
                        domain TEXT,
                        password TEXT,
                        hash TEXT,
                        hash_type TEXT,
                        notes TEXT,
                        status TEXT DEFAULT 'none',
                        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                        updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                    )
                ''')

                # Copy data
                cursor.execute('''
                    INSERT INTO credentials_new
                    SELECT * FROM credentials
                ''')

                # Drop old table and rename new one
                cursor.execute('DROP TABLE credentials')
                cursor.execute('ALTER TABLE credentials_new RENAME TO credentials')
        else:
            # Create new table
            cursor.execute('''
                CREATE TABLE IF NOT EXISTS credentials (
                    id INTEGER PRIMARY KEY AUTOINCREMENT,
                    machine TEXT,
                    username TEXT,
                    domain TEXT,
                    password TEXT,
                    hash TEXT,
                    hash_type TEXT,
                    notes TEXT,
                    status TEXT DEFAULT 'none',
                    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                )
            ''')

        conn.commit()
        conn.close()

    def add_credential(self, machine=None, username=None, password=None, hash_val=None, hash_type=None, domain=None, notes=None):
        """Add a credential entry"""
        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        try:
            cursor.execute('''
                INSERT INTO credentials (machine, username, domain, password, hash, hash_type, notes)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            ''', (machine, username, domain, password, hash_val, hash_type, notes))

            conn.commit()
            return True
        except sqlite3.Error as e:
            print(f"{Colors.RED}Database error: {e}{Colors.RESET}")
            return False
        finally:
            conn.close()

    def delete_credential(self, cred_id):
        """Delete a credential by ID"""
        if not self.db_path.exists():
            return False

        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('DELETE FROM credentials WHERE id = ?', (cred_id,))
        deleted = cursor.rowcount

        conn.commit()
        conn.close()
        return deleted > 0

