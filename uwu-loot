def parse_args(args):
    """Parse command line arguments"""
    data = {
        'machine': None,
        'username': None,
        'domain': None,
        'password': None,
        'hash': None,
        'hash_type': None,
        'notes': None
    }

    if len(args) < 1:
        return data

    # Check if first argument is a positional (machine) or a flag
    i = 0
    if i < len(args) and not args[i].startswith('-'):
        data['machine'] = args[i]
        i = 1

    # Check if second argument is a positional (username) or a flag
    if i < len(args) and not args[i].startswith('-'):
        data['username'] = args[i]
        i += 1

    # Parse remaining flags
    while i < len(args):
        if args[i] in ['-u', '--username'] and i + 1 < len(args):
            data['username'] = args[i + 1]
            i += 2
        elif args[i] in ['-d', '--domain'] and i + 1 < len(args):
            data['domain'] = args[i + 1]
            i += 2
        elif args[i] in ['-p', '--password'] and i + 1 < len(args):
            data['password'] = args[i + 1]
            i += 2
        elif args[i] in ['-H', '--hash'] and i + 1 < len(args):
            data['hash'] = args[i + 1]
            i += 2
        elif args[i] in ['-t', '--hash-type'] and i + 1 < len(args):
            data['hash_type'] = args[i + 1]
            i += 2
        elif args[i] in ['-n', '--notes'] and i + 1 < len(args):
            data['notes'] = args[i + 1]
            i += 2
        else:
            print(f"{Colors.YELLOW}Warning: Unknown argument '{args[i]}'{Colors.RESET}")
            i += 1

    return data

def main():
    # Check for help flag
    if len(sys.argv) > 1 and sys.argv[1] in ['-h', '--help', 'help']:
        print_help()
        sys.exit(0)

    if len(sys.argv) < 2:
        print(f"{Colors.RED}Error: At least one argument is required{Colors.RESET}")
        print(f"Run {Colors.CYAN}uwu-loot -h{Colors.RESET} for help\n")
        sys.exit(1)

    db = CTFCredsDB()

    # Handle delete command
    if sys.argv[1] == 'delete':
        if len(sys.argv) < 3:
            print(f"{Colors.RED}Error: Credential ID required{Colors.RESET}")
            print(f"Usage: {Colors.CYAN}uwu-loot delete <id>{Colors.RESET}\n")
            sys.exit(1)

        try:
            cred_id = int(sys.argv[2])
            if db.delete_credential(cred_id):
                print(f"\n{Colors.GREEN}✓ Entry {cred_id} deleted successfully!{Colors.RESET}\n")
            else:
                print(f"\n{Colors.RED}✗ Entry not found{Colors.RESET}\n")
        except ValueError:
            print(f"{Colors.RED}Error: Invalid ID. Must be a number.{Colors.RESET}\n")
        sys.exit(0)

    data = parse_args(sys.argv[1:])

    # Check that at least one piece of data is provided
    if not any([data['machine'], data['username'], data['password'], data['hash'], data['notes']]):
        print(f"{Colors.RED}Error: At least one of machine, username, password, hash, or notes must be provided{Colors.RESET}")
        print(f"Run {Colors.CYAN}uwu-loot -h{Colors.RESET} for help\n")
        sys.exit(1)

    if db.add_credential(
        data['machine'],
        data['username'],
        data['password'],
        data['hash'],
        data['hash_type'],
        data['domain'],
        data['notes']
    ):
        print(f"\n{Colors.GREEN}✓ Entry added successfully!{Colors.RESET}")
        if data['machine']:
            print(f"{Colors.CYAN}Machine:{Colors.RESET} {data['machine']}")
        if data['domain']:
            print(f"{Colors.CYAN}Domain:{Colors.RESET} {data['domain']}")
        if data['username']:
            print(f"{Colors.CYAN}Username:{Colors.RESET} {data['username']}")
        if data['password']:
            print(f"{Colors.CYAN}Password:{Colors.RESET} {data['password']}")
        if data['hash']:
            print(f"{Colors.CYAN}Hash:{Colors.RESET} {data['hash'][:30]}...")
        if data['notes']:
            print(f"{Colors.CYAN}Notes:{Colors.RESET} {data['notes']}")
        print()

if __name__ == '__main__':
    main()
