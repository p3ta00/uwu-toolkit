#!/usr/bin/env python3
"""
uwu-list - List CTF credentials from database
Part of the uwu-* CTF toolkit
"""

import sqlite3
import sys
import os
from pathlib import Path

# Dracula Theme Colors
class Colors:
    RESET = '\033[0m'
    BOLD = '\033[1m'
    CYAN = '\033[38;2;139;233;253m'
    GREEN = '\033[38;2;80;250;123m'
    ORANGE = '\033[38;2;255;184;108m'
    PINK = '\033[38;2;255;121;198m'
    PURPLE = '\033[38;2;189;147;249m'
    RED = '\033[38;2;255;85;85m'
    YELLOW = '\033[38;2;241;250;140m'
    COMMENT = '\033[38;2;98;114;164m'

class CTFCredsDB:
    def __init__(self):
        self.db_dir = Path(os.getcwd()) / '.ctf'
        self.db_path = self.db_dir / 'credentials.db'

    def get_all_credentials(self):
        """Retrieve all credentials"""
        if not self.db_path.exists():
            return []

        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
            SELECT id, machine, username, domain, password, hash, hash_type, notes, status, created_at, updated_at
            FROM credentials
            ORDER BY machine, username
        ''')

        results = cursor.fetchall()
        conn.close()
        return results

    def get_by_machine(self, machine):
        """Get credentials for a specific machine"""
        if not self.db_path.exists():
            return []

        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
            SELECT id, machine, username, domain, password, hash, hash_type, notes, status, created_at, updated_at
            FROM credentials
            WHERE machine LIKE ?
            ORDER BY username
        ''', (f'%{machine}%',))

        results = cursor.fetchall()
        conn.close()
        return results

    def get_pwned(self):
        """Get the credential marked as pwned"""
        if not self.db_path.exists():
            return None

        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
            SELECT id, machine, username, domain, password, hash, hash_type, notes, status, created_at, updated_at
            FROM credentials
            WHERE status = 'pwned'
            LIMIT 1
        ''')

        result = cursor.fetchone()
        conn.close()
        return result

    def get_target(self):
        """Get the credential marked as target"""
        if not self.db_path.exists():
            return None

        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
            SELECT id, machine, username, domain, password, hash, hash_type, notes, status, created_at, updated_at
            FROM credentials
            WHERE status = 'target'
            LIMIT 1
        ''')

        result = cursor.fetchone()
        conn.close()
        return result

