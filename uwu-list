def display_credentials(credentials, title="All Credentials"):
    """Display credentials in a nice Dracula-themed table"""
    if not credentials:
        print(f"\n{Colors.YELLOW}No credentials found.{Colors.RESET}\n")
        return

    print(f"\n{Colors.PINK}{title}{Colors.RESET}")
    print(f"{Colors.PURPLE}{'═' * 180}{Colors.RESET}")
    print(f"{Colors.PINK}{Colors.BOLD}{'ID':<5} {'Machine':<25} {'Domain':<15} {'Username':<20} {'Password':<20} {'Hash':<30} {'Type':<10} {'Status':<10}{Colors.RESET}")
    print(f"{Colors.PURPLE}{'═' * 180}{Colors.RESET}")

    for cred in credentials:
        cred_id, machine, username, domain, password, hash_val, hash_type, notes, status, created, updated = cred

        # Truncate long values for display
        machine_display = (machine[:22] + '...') if machine and len(machine) > 25 else (machine or '-')
        username_display = (username[:17] + '...') if username and len(username) > 20 else (username or '-')
        domain_display = (domain[:12] + '...') if domain and len(domain) > 15 else (domain or '-')
        password_display = (password[:17] + '...') if password and len(password) > 20 else (password or '-')
        hash_display = (hash_val[:27] + '...') if hash_val and len(hash_val) > 30 else (hash_val or '-')
        hash_type_display = hash_type or '-'

        # Color status based on value
        if status == 'pwned':
            status_display = f"{Colors.GREEN}{status:<10}{Colors.RESET}"
        elif status == 'target':
            status_display = f"{Colors.RED}{status:<10}{Colors.RESET}"
        else:
            status_display = f"{Colors.COMMENT}{'-':<10}{Colors.RESET}"

        print(f"{Colors.CYAN}{cred_id:<5}{Colors.RESET} "
              f"{Colors.GREEN}{machine_display:<25}{Colors.RESET} "
              f"{Colors.PURPLE}{domain_display:<15}{Colors.RESET} "
              f"{Colors.ORANGE}{username_display:<20}{Colors.RESET} "
              f"{Colors.YELLOW}{password_display:<20}{Colors.RESET} "
              f"{Colors.PURPLE}{hash_display:<30}{Colors.RESET} "
              f"{Colors.COMMENT}{hash_type_display:<10}{Colors.RESET} "
              f"{status_display}")

    print(f"{Colors.PURPLE}{'═' * 180}{Colors.RESET}\n")
    print(f"{Colors.GREEN}Total: {len(credentials)} credential(s){Colors.RESET}\n")

def main():
    # Check for help flag
    if len(sys.argv) > 1 and sys.argv[1] in ['-h', '--help', 'help']:
        print_help()
        sys.exit(0)

    db = CTFCredsDB()

    # Check if database exists
    if not db.db_path.exists():
        print(f"{Colors.YELLOW}No credentials database found.{Colors.RESET}")
        print(f"Use {Colors.CYAN}uwu-loot{Colors.RESET} to add credentials.\n")
        sys.exit(0)

    # Show selected credentials
    if len(sys.argv) > 1 and sys.argv[1] in ['-s', '--selected']:
        print_banner()
        pwned = db.get_pwned()
        target = db.get_target()

        if pwned:
            print(f"\n{Colors.GREEN}{Colors.BOLD}PWNED CREDENTIAL:{Colors.RESET}")
            display_credentials([pwned], "")
        else:
            print(f"\n{Colors.YELLOW}No pwned credential selected{Colors.RESET}\n")

        if target:
            print(f"{Colors.RED}{Colors.BOLD}TARGET CREDENTIAL:{Colors.RESET}")
            display_credentials([target], "")
        else:
            print(f"{Colors.YELLOW}No target credential selected{Colors.RESET}\n")

    # Filter by machine
    elif len(sys.argv) > 1:
        machine = sys.argv[1]
        print_banner()
        credentials = db.get_by_machine(machine)
        display_credentials(credentials, f"Credentials for: {machine}")

    # Show all
    else:
        print_banner()
        credentials = db.get_all_credentials()
        display_credentials(credentials)

if __name__ == '__main__':
    main()
