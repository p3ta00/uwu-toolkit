#!/usr/bin/env python3
"""
uwu-export - Export credentials to environment variables
Part of the uwu-* CTF toolkit
"""

import sqlite3
import sys
import os
from pathlib import Path

# Dracula Theme Colors
class Colors:
    RESET = '\033[0m'
    BOLD = '\033[1m'
    CYAN = '\033[38;2;139;233;253m'
    GREEN = '\033[38;2;80;250;123m'
    ORANGE = '\033[38;2;255;184;108m'
    PINK = '\033[38;2;255;121;198m'
    PURPLE = '\033[38;2;189;147;249m'
    RED = '\033[38;2;255;85;85m'
    YELLOW = '\033[38;2;241;250;140m'
    COMMENT = '\033[38;2;98;114;164m'

class CTFCredsDB:
    def __init__(self):
        self.db_dir = Path(os.getcwd()) / '.ctf'
        self.db_path = self.db_dir / 'credentials.db'

    def get_pwned(self):
        """Get the credential marked as pwned"""
        if not self.db_path.exists():
            return None

        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
            SELECT id, machine, username, domain, password, hash, hash_type, notes, status, created_at, updated_at
            FROM credentials
            WHERE status = 'pwned'
            LIMIT 1
        ''')

        result = cursor.fetchone()
        conn.close()
        return result

    def get_target(self):
        """Get the credential marked as target"""
        if not self.db_path.exists():
            return None

        conn = sqlite3.connect(self.db_path)
        cursor = conn.cursor()

        cursor.execute('''
            SELECT id, machine, username, domain, password, hash, hash_type, notes, status, created_at, updated_at
            FROM credentials
            WHERE status = 'target'
            LIMIT 1
        ''')

        result = cursor.fetchone()
        conn.close()
        return result

    def export_env(self):
        """Export pwned and target credentials as environment variables"""
        pwned = self.get_pwned()
        target = self.get_target()

        env_vars = []

        if pwned:
            _, machine, username, domain, password, hash_val, hash_type, notes, status, _, _ = pwned
            env_vars.append(f'export PWNED_USER="{username}"')
            env_vars.append(f'export PWNED_DOMAIN="{domain or ""}"')
            env_vars.append(f'export PWNED_PASS="{password or ""}"')
            env_vars.append(f'export PWNED_HASH="{hash_val or ""}"')
            env_vars.append(f'export PWNED_MACHINE="{machine}"')

        if target:
            _, machine, username, domain, password, hash_val, hash_type, notes, status, _, _ = target
            env_vars.append(f'export TARGET_USER="{username}"')
            env_vars.append(f'export TARGET_DOMAIN="{domain or ""}"')
            env_vars.append(f'export TARGET_PASS="{password or ""}"')
            env_vars.append(f'export TARGET_HASH="{hash_val or ""}"')
            env_vars.append(f'export TARGET_MACHINE="{machine}"')

        return env_vars

