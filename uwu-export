def main():
    # Check for help flag
    if len(sys.argv) > 1 and sys.argv[1] in ['-h', '--help', 'help']:
        print_help()
        sys.exit(0)

    db = CTFCredsDB()
    env_vars = db.export_env()

    # Show mode
    if len(sys.argv) > 1 and sys.argv[1] == '--show':
        if env_vars:
            print(f"\n{Colors.GREEN}Exported Variables:{Colors.RESET}\n")
            for var in env_vars:
                # Pretty print without 'export'
                var_clean = var.replace('export ', '')
                var_name = var_clean.split('=')[0]
                var_value = var_clean.split('=')[1].strip('"')
                if var_value:
                    print(f"  {Colors.YELLOW}{var_name}{Colors.RESET} = {Colors.CYAN}{var_value}{Colors.RESET}")
            print()
        else:
            print(f"\n{Colors.YELLOW}No credentials selected.{Colors.RESET}")
            print(f"Use {Colors.CYAN}uwu-pwned{Colors.RESET} and {Colors.CYAN}uwu-target{Colors.RESET} to mark credentials.\n")
    else:
        # Export mode (default)
        for var in env_vars:
            print(var)

if __name__ == '__main__':
    main()
