_uwu_navi_completion() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"

    opts="show list load env export -h --help"
    COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )
    return 0
}

# Register completions
complete -F _uwu_loot_completion uwu-loot
complete -F _uwu_list_completion uwu-list
complete -F _uwu_pwned_completion uwu-pwned
complete -F _uwu_target_completion uwu-target
complete -F _uwu_export_completion uwu-export
complete -F _uwu_navi_completion uwu-navi
