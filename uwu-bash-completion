#!/bin/bash
# Bash completion for uwu-* CTF tools

_uwu_loot_completion() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    opts="-d --domain -p --password -H --hash -t --hash-type -n --notes -h --help"

    case "${prev}" in
        -t|--hash-type)
            COMPREPLY=( $(compgen -W "NTLM MD5 SHA256 SHA1 SHA512" -- ${cur}) )
            return 0
            ;;
        -d|--domain|-p|--password|-H|--hash|-n|--notes)
            return 0
            ;;
        *)
            COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )
            return 0
            ;;
    esac
}

_uwu_list_completion() {
    local cur prev opts
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"

    opts="-s --selected -h --help"
    COMPREPLY=( $(compgen -W "${opts}" -- ${cur}) )
    return 0
}

