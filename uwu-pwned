    """Print usage help"""
    help_text = f"""
{Colors.PURPLE}╔═══════════════════════════════════════════════════════════╗
║                                                           ║
║       {Colors.GREEN}🎯 uwu-pwned - Mark Pwned Credentials 🎯{Colors.PURPLE}         ║
║                                                           ║
╚═══════════════════════════════════════════════════════════╝{Colors.RESET}

{Colors.GREEN}USAGE:{Colors.RESET}
    {Colors.CYAN}uwu-pwned{Colors.RESET} {Colors.ORANGE}<id>{Colors.RESET}           Mark credential as pwned
    {Colors.CYAN}uwu-pwned{Colors.RESET} {Colors.YELLOW}clear{Colors.RESET} {Colors.ORANGE}<id>{Colors.RESET}    Clear pwned status
    {Colors.CYAN}uwu-pwned{Colors.RESET} {Colors.YELLOW}delete{Colors.RESET} {Colors.ORANGE}<id>{Colors.RESET}   Delete credential
    {Colors.CYAN}uwu-pwned{Colors.RESET} {Colors.YELLOW}-h{Colors.RESET}             Show this help

{Colors.GREEN}DESCRIPTION:{Colors.RESET}
    Mark credentials that you've successfully compromised. Only one
    credential can be marked as 'pwned' at a time. Marking a new one
    will automatically clear the previous pwned status.

{Colors.GREEN}OPTIONS:{Colors.RESET}
    {Colors.ORANGE}<id>{Colors.RESET}               Credential ID to mark as pwned
    {Colors.YELLOW}clear{Colors.RESET} {Colors.ORANGE}<id>{Colors.RESET}        Clear the pwned status
    {Colors.YELLOW}delete{Colors.RESET} {Colors.ORANGE}<id>{Colors.RESET}       Delete the credential entirely
    {Colors.YELLOW}-h, --help{Colors.RESET}        Show this help message

{Colors.GREEN}EXAMPLES:{Colors.RESET}
    {Colors.COMMENT}# Mark credential ID 3 as pwned{Colors.RESET}
    {Colors.CYAN}uwu-pwned{Colors.RESET} {Colors.ORANGE}3{Colors.RESET}

    {Colors.COMMENT}# Clear pwned status from credential ID 3{Colors.RESET}
    {Colors.CYAN}uwu-pwned{Colors.RESET} {Colors.YELLOW}clear{Colors.RESET} {Colors.ORANGE}3{Colors.RESET}

    {Colors.COMMENT}# Delete credential ID 5{Colors.RESET}
    {Colors.CYAN}uwu-pwned{Colors.RESET} {Colors.YELLOW}delete{Colors.RESET} {Colors.ORANGE}5{Colors.RESET}

{Colors.GREEN}WORKFLOW:{Colors.RESET}
    {Colors.CYAN}1.{Colors.RESET} List credentials:     {Colors.CYAN}uwu-list{Colors.RESET}
