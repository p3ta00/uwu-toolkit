{Colors.GREEN}RELATED TOOLS:{Colors.RESET}
    {Colors.CYAN}uwu-loot{Colors.RESET}      Add credentials to database
    {Colors.CYAN}uwu-list{Colors.RESET}      List all credentials
    {Colors.CYAN}uwu-target{Colors.RESET}    Mark target credentials
    {Colors.CYAN}uwu-export{Colors.RESET}    Export to environment variables
"""
    print(help_text)

def main():
    # Check for help flag
    if len(sys.argv) > 1 and sys.argv[1] in ['-h', '--help', 'help']:
        print_help()
        sys.exit(0)

    if len(sys.argv) < 2:
        print(f"{Colors.RED}Error: Credential ID required{Colors.RESET}")
        print(f"Run {Colors.CYAN}uwu-pwned -h{Colors.RESET} for help\n")
        sys.exit(1)

    db = CTFCredsDB()

    # Handle clear command
    if sys.argv[1] == 'clear':
        if len(sys.argv) < 3:
            print(f"{Colors.RED}Error: Credential ID required{Colors.RESET}")
            sys.exit(1)

        try:
            cred_id = int(sys.argv[2])
            if db.set_status(cred_id, 'none'):
                print(f"\n{Colors.GREEN}✓ Status cleared for credential {cred_id}{Colors.RESET}\n")
            else:
                print(f"\n{Colors.RED}✗ Credential not found{Colors.RESET}\n")
        except ValueError:
            print(f"{Colors.RED}Error: Invalid ID{Colors.RESET}")

    # Handle delete command
    elif sys.argv[1] == 'delete':
        if len(sys.argv) < 3:
            print(f"{Colors.RED}Error: Credential ID required{Colors.RESET}")
            sys.exit(1)

        try:
            cred_id = int(sys.argv[2])
            if db.delete_credential(cred_id):
                print(f"\n{Colors.GREEN}✓ Credential deleted successfully!{Colors.RESET}\n")
            else:
                print(f"\n{Colors.RED}✗ Credential not found{Colors.RESET}\n")
        except ValueError:
            print(f"{Colors.RED}Error: Invalid ID{Colors.RESET}")

    # Mark as pwned
    else:
        try:
            cred_id = int(sys.argv[1])
            if db.set_status(cred_id, 'pwned'):
                print(f"\n{Colors.GREEN}✓ Credential {cred_id} marked as PWNED!{Colors.RESET}\n")
            else:
                print(f"\n{Colors.RED}✗ Credential not found{Colors.RESET}\n")
        except ValueError:
            print(f"{Colors.RED}Error: Invalid ID{Colors.RESET}")

if __name__ == '__main__':
    main()
